{
  "name": "esc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the UC Berkeley Engineering Student Council (esc.studentorg.berkeley.edu).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --test-reporter=spec \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check:data": "node scripts/validate-data.mjs",
    "lhci": "lhci autorun",
    "baseline:update": "UPDATE_BASELINE=1 playwright test --project=desktop --workers=1",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:search": "node scripts/build-search-index.mjs",
    "check:search": "node scripts/build-search-index.mjs --check",
    "test:stress": "node --test --test-reporter=spec \"tests/stress/**/*.test.mjs\"",
    "vendor:fuse": "cp node_modules/fuse.js/dist/fuse.min.mjs assets/js/vendor/fuse.esm.min.js",
    "build:og": "node scripts/build-og.mjs",
    "check:og": "node scripts/build-og.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.12.0",
    "fuse.js": "^7.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
